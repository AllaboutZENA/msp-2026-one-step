# apps/api/.env.example — copy to apps/api/.env and fill in locally.
# Real values (passwords, secrets) must never be committed or pasted into issues/PRs.

# API listens only on loopback; Nginx (EC2) or the simulator on this Mac reaches it.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# PostgreSQL connection. URL-encode special characters in the password.
# Local Mac example (Homebrew PostgreSQL, OS user auth):
#   DATABASE_URL=postgresql://<MAC_USER>@127.0.0.1:5432/magam_hankan_dev
# EC2 (after server access is confirmed):
#   DATABASE_URL=postgresql://<DB_USER>:<URL_ENCODED_PASSWORD>@127.0.0.1:5432/<DB_NAME>
DATABASE_URL=

# Auth variables are added after the auth method is decided (week 3-4).
