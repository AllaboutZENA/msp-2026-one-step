# apps/mobile/.env.example — copy to apps/mobile/.env.local (git-ignored).
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone: no secrets.
#
# iOS Simulator on this Mac shares the Mac's network, so localhost reaches the local API.
# EC2 dev server (simulator and real phones): the HTTPS address shared in the team channel,
#   EXPO_PUBLIC_API_BASE_URL=https://<server-host>
# A real phone's "localhost" is the phone itself, so it must use the HTTPS address.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
