# apps/mobile/.env.example — copy to apps/mobile/.env.local (git-ignored).
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone: no secrets.
#
# iOS Simulator on this Mac shares the Mac's network, so localhost reaches the local API.
# EC2 dev server: open `ssh -N -L 3001:127.0.0.1:3000 magam-dev`, then use http://localhost:3001.
# A real phone's "localhost" is the phone itself — use the Mac's LAN IP or the EC2 HTTPS URL (not set up yet).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
